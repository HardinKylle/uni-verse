# Supabase — copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). Same values go in Vercel for deployment.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: username lookup/sign-in and shared auth rate limiting.
# Also used by Playwright to create/delete disposable test users.
# Set only in server environments; NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dev/test-only password account — a rate-limit-free fallback login (Supabase's
# built-in email service allows only a few auth emails/hour). Created once via the
# service-role admin API with email pre-confirmed; app code never reads these.
# dev/test only — never a real personal password.
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=
