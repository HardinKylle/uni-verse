# Supabase — copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). Same values go in Vercel for deployment.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used exclusively by Playwright e2e fixtures to create/delete test users.
# NEVER expose to the browser or set in Vercel; app code never imports it.
SUPABASE_SERVICE_ROLE_KEY=
